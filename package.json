{
  "name": "finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "ports": "node scripts/worktree-ports.mjs",
    "build": "next build",
    "start": "next start",
    "type": "next typegen && tsc --noEmit",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:prune": "node scripts/lint-prune.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test": "vitest run",
    "inspect": "pnpm type && pnpm lint && pnpm test:scripts && pnpm test",
    "clean:caches": "rm -rf .next",
    "clean:modules": "rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,md,json,yaml,yml}\"",
    "audit": "pnpm audit --audit-level=high",
    "deps:check": "pnpm -r outdated",
    "deps:update": "pnpm -r update && pnpm inspect && pnpm build",
    "deps:update:major": "pnpm -r up -iL",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,css,md,json,yaml,yml}": "prettier --write"
  },
  "packageManager": "pnpm@11.18.0"
}
